generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id
  name       String?
  email      String?
  avatar     String?
  createdAt  DateTime  @default(now())
  
  habits     Odatlar[]
  checkIns   CheckIn[]
}

model Odatlar {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  color         String   @default("#22344F")
  frequency     String   @default("deily")
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  checkIns      CheckIn[]
 
  @@index([userId])
}

model CheckIn {
  id        Int      @id @default(autoincrement())
  habitId   Int
  habit     Odatlar    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([habitId])
  @@index([userId]) 
  @@index([date])
}
